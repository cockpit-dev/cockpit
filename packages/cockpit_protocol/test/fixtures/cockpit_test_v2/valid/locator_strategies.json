{
  "schemaVersion": "cockpit.test/v2",
  "kind": "case",
  "id": "locatorStrategies",
  "target": {
    "platform": "android",
    "targetKind": "nativeApp",
    "plane": "coordinate"
  },
  "steps": [
    {
      "stepId": "tapCoordinate",
      "action": {
        "type": "tap",
        "locator": {
          "x": 0.5,
          "y": 0.75,
          "fallbacks": [
            {
              "visual": "assets/continue.png",
              "threshold": 0.9
            },
            {
              "text": "Continue",
              "matchMode": "contains",
              "index": 0,
              "ancestor": {
                "role": "dialog"
              }
            }
          ]
        }
      }
    }
  ]
}
